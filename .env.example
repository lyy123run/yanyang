# 生产环境变量示例：复制为 .env 并按实际修改（deploy.sh 会读取）
DJANGO_SECRET_KEY=请替换为随机长字符串
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=你的域名,服务器公网IP
DJANGO_CSRF_TRUSTED_ORIGINS=https://你的域名
LOG_DIR=/var/log/marathon

# 邮箱推送（QQ/163 邮箱需先开启 SMTP 并使用授权码，不是登录密码）
EMAIL_DEMO=0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=你的邮箱@qq.com
EMAIL_HOST_PASSWORD=邮箱授权码
DEFAULT_FROM_EMAIL=马拉松训练系统 <你的邮箱@qq.com>
